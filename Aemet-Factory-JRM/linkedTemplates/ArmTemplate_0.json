{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Nombre de instancia de Data Factory",
			"defaultValue": "Aemet-Factory-JRM"
		},
		"AzureSqlDatabaseAemet_password": {
			"type": "secureString",
			"metadata": "Cadena protegida para \"password\"de \"AzureSqlDatabaseAemet\""
		},
		"BD_AEMET_password": {
			"type": "secureString",
			"metadata": "Cadena protegida para \"password\"de \"BD_AEMET\""
		},
		"AzureSqlDatabaseAemet_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "aemet.database.windows.net"
		},
		"AzureSqlDatabaseAemet_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "proyecto_aemet"
		},
		"AzureSqlDatabaseAemet_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "aemet"
		},
		"BD_AEMET_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "localhost:1521/XE"
		},
		"BD_AEMET_properties_typeProperties_username": {
			"type": "string",
			"defaultValue": "aemet"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "[concat(parameters('factoryName'), '/AzureSqlDatabaseAemet')]",
			"type": "Microsoft.DataFactory/factories/linkedServices",
			"apiVersion": "2018-06-01",
			"properties": {
				"annotations": [],
				"type": "AzureSqlDatabase",
				"typeProperties": {
					"server": "[parameters('AzureSqlDatabaseAemet_properties_typeProperties_server')]",
					"database": "[parameters('AzureSqlDatabaseAemet_properties_typeProperties_database')]",
					"encrypt": "mandatory",
					"trustServerCertificate": false,
					"authenticationType": "SQL",
					"userName": "[parameters('AzureSqlDatabaseAemet_properties_typeProperties_userName')]",
					"password": {
						"type": "SecureString",
						"value": "[parameters('AzureSqlDatabaseAemet_password')]"
					}
				}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/IR-Local-Oracle')]",
			"type": "Microsoft.DataFactory/factories/integrationRuntimes",
			"apiVersion": "2018-06-01",
			"properties": {
				"type": "SelfHosted",
				"typeProperties": {}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/BD_AEMET')]",
			"type": "Microsoft.DataFactory/factories/linkedServices",
			"apiVersion": "2018-06-01",
			"properties": {
				"annotations": [],
				"type": "Oracle",
				"version": "2.0",
				"typeProperties": {
					"server": "[parameters('BD_AEMET_properties_typeProperties_server')]",
					"authenticationType": "Basic",
					"username": "[parameters('BD_AEMET_properties_typeProperties_username')]",
					"password": {
						"type": "SecureString",
						"value": "[parameters('BD_AEMET_password')]"
					},
					"encryptionClient": "accepted",
					"encryptionTypesClient": "(AES128, AES192, AES256, 3DES112, 3DES168)",
					"cryptoChecksumClient": "accepted",
					"cryptoChecksumTypesClient": "(SHA1, SHA256, SHA384, SHA512)"
				},
				"connectVia": {
					"referenceName": "IR-Local-Oracle",
					"type": "IntegrationRuntimeReference"
				}
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/integrationRuntimes/IR-Local-Oracle')]"
			]
		}
	]
}